@model StudentManagementSystem.Models.Department

@{
    ViewData["Title"] = "Delete Department";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold mb-1 text-danger">
                <i class="bi bi-trash3-fill me-2"></i>
                Delete Department
            </h1>

            <p class="text-muted mb-0">
                Review the department before permanently deleting it.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-2"></i>
            Back to Departments

        </a>

    </div>


    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4">

                    <div class="alert alert-danger">

                        <div class="d-flex">

                            <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>

                            <div>

                                <strong>
                                    Delete this department?
                                </strong>

                                <p class="mb-0 mt-1">
                                    This action cannot be undone.
                                </p>

                            </div>

                        </div>

                    </div>


                    <div class="text-center my-4">

                        <div class="rounded-3 bg-primary-subtle text-primary d-flex align-items-center justify-content-center mx-auto mb-3"
                             style="width:80px;height:80px;font-size:32px;">

                            <i class="bi bi-building-fill"></i>

                        </div>

                        <h3 class="fw-bold mb-1">
                            @Model.DepartmentName
                        </h3>

                        <p class="text-muted">
                            @Model.DepartmentCode
                        </p>

                    </div>


                    <div class="row g-3 mb-4">

                        <div class="col-md-6">

                            <div class="border rounded-3 p-3">

                                <small class="text-muted d-block">
                                    Head of Department
                                </small>

                                <strong>
                                    @(Model.HeadOfDepartment ?? "Not assigned")
                                </strong>

                            </div>

                        </div>


                        <div class="col-md-6">

                            <div class="border rounded-3 p-3">

                                <small class="text-muted d-block">
                                    Status
                                </small>

                                <strong>
                                    @Model.Status
                                </strong>

                            </div>

                        </div>

                    </div>


                    @if (Model.Students.Any())
                    {
                        <div class="alert alert-warning">

                            <i class="bi bi-info-circle me-2"></i>

                            This department currently has
                            <strong>@Model.Students.Count</strong>
                            assigned student(s).

                            You may need to reassign those students
                            before deleting the department.

                        </div>
                    }


                    <form asp-action="Delete"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="DepartmentId" />

                        <div class="d-flex justify-content-center gap-2">

                            <a asp-action="Index"
                               class="btn btn-light border px-4">

                                <i class="bi bi-x-circle me-2"></i>
                                Cancel

                            </a>

                            <button type="submit"
                                    class="btn btn-danger px-4">

                                <i class="bi bi-trash3 me-2"></i>
                                Delete Department

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>
