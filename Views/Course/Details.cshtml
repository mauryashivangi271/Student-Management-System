@model StudentManagementSystem.Models.Course

@{
    ViewData["Title"] = "Course Details";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold mb-1">
                <i class="bi bi-book-fill me-2"></i>
                Course Details
            </h1>

            <p class="text-muted mb-0">
                View complete course information.
            </p>
        </div>

        <div class="d-flex gap-2">

            <a asp-action="Edit"
               asp-route-id="@Model.CourseId"
               class="btn btn-primary">

                <i class="bi bi-pencil me-2"></i>
                Edit

            </a>

            <a asp-action="Index"
               class="btn btn-outline-secondary">

                <i class="bi bi-arrow-left me-2"></i>
                Back

            </a>

        </div>

    </div>


    <div class="row g-4">

        <div class="col-lg-8">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4">

                    <div class="d-flex align-items-center mb-4">

                        <div class="rounded-3 bg-primary-subtle text-primary d-flex align-items-center justify-content-center me-3"
                             style="width:65px;height:65px;font-size:28px;">

                            <i class="bi bi-book-fill"></i>

                        </div>

                        <div>

                            <h3 class="fw-bold mb-1">
                                @Model.CourseName
                            </h3>

                            <span class="text-muted">
                                @Model.CourseCode
                            </span>

                        </div>

                    </div>


                    <div class="row g-4">

                        <div class="col-md-6">

                            <small class="text-muted d-block">
                                Course Code
                            </small>

                            <strong>
                                @Model.CourseCode
                            </strong>

                        </div>


                        <div class="col-md-6">

                            <small class="text-muted d-block">
                                Duration
                            </small>

                            <strong>
                                @(string.IsNullOrWhiteSpace(Model.Duration)
                                    ? "Not specified"
                                    : Model.Duration)
                            </strong>

                        </div>


                        <div class="col-md-6">

                            <small class="text-muted d-block">
                                Status
                            </small>

                            @if (Model.Status == "Active")
                            {
                                <span class="badge bg-success-subtle text-success">
                                    <i class="bi bi-check-circle me-1"></i>
                                    Active
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary">
                                    Inactive
                                </span>
                            }

                        </div>


                        <div class="col-md-6">

                            <small class="text-muted d-block">
                                Course ID
                            </small>

                            <strong>
                                #@Model.CourseId
                            </strong>

                        </div>

                    </div>


                    <hr class="my-4" />


                    <h5 class="fw-bold mb-3">
                        <i class="bi bi-file-text me-2"></i>
                        Description
                    </h5>

                    <p class="text-muted mb-0">
                        @(string.IsNullOrWhiteSpace(Model.Description)
                            ? "No description has been added for this course."
                            : Model.Description)
                    </p>

                </div>

            </div>

        </div>


        <div class="col-lg-4">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4 text-center">

                    <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center mx-auto mb-3"
                         style="width:80px;height:80px;font-size:30px;">

                        <i class="bi bi-people-fill"></i>

                    </div>

                    <h2 class="fw-bold">
                        @Model.Students.Count
                    </h2>

                    <p class="text-muted mb-0">
                        Enrolled Students
                    </p>

                </div>

            </div>


            <div class="card border-0 shadow-sm mt-4">

                <div class="card-body p-4">

                    <h6 class="fw-bold mb-2">
                        Course Management
                    </h6>

                    <p class="text-muted small">
                        You can edit course information or remove this
                        course from the system.
                    </p>

                    <a asp-action="Delete"
                       asp-route-id="@Model.CourseId"
                       class="btn btn-outline-danger w-100">

                        <i class="bi bi-trash3 me-2"></i>
                        Delete Course

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>
