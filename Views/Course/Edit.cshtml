@model StudentManagementSystem.Models.Course

@{
    ViewData["Title"] = "Edit Course";
}

<div class="page-header">
    <div>
        <h1>Edit Course</h1>
        <p>Update the information of this course.</p>
    </div>

    <a asp-action="Index" class="btn btn-secondary">
        ← Back to Courses
    </a>
</div>

<div class="student-card">

    <div class="student-card-header">
        <div>
            <h4>Course Information</h4>
            <span>Update course details below</span>
        </div>
    </div>

    <form asp-action="Edit" method="post" class="p-4">

        <input type="hidden" asp-for="CourseId" />

        <div class="row">

            <!-- Course Name -->
            <div class="col-md-6 mb-3">
                <label asp-for="CourseName" class="form-label">
                    Course Name
                </label>

                <input asp-for="CourseName"
                       class="form-control"
                       placeholder="Enter course name" />

                <span asp-validation-for="CourseName"
                      class="text-danger"></span>
            </div>

            <!-- Course Code -->
            <div class="col-md-6 mb-3">
                <label asp-for="CourseCode" class="form-label">
                    Course Code
                </label>

                <input asp-for="CourseCode"
                       class="form-control"
                       placeholder="Enter course code" />

                <span asp-validation-for="CourseCode"
                      class="text-danger"></span>
            </div>

            <!-- Duration -->
            <div class="col-md-6 mb-3">
                <label asp-for="Duration" class="form-label">
                    Duration
                </label>

                <input asp-for="Duration"
                       class="form-control"
                       placeholder="e.g. 3 Years" />

                <span asp-validation-for="Duration"
                      class="text-danger"></span>
            </div>

            <!-- Status -->
            <div class="col-md-6 mb-3">
                <label asp-for="Status" class="form-label">
                    Status
                </label>

                <select asp-for="Status" class="form-select">

                    <option value="Active">
                        Active
                    </option>

                    <option value="Inactive">
                        Inactive
                    </option>

                </select>

                <span asp-validation-for="Status"
                      class="text-danger"></span>
            </div>

            <!-- Description -->
            <div class="col-12 mb-3">
                <label asp-for="Description" class="form-label">
                    Description
                </label>

                <textarea asp-for="Description"
                          class="form-control"
                          rows="4"
                          placeholder="Enter course description"></textarea>

                <span asp-validation-for="Description"
                      class="text-danger"></span>
            </div>

        </div>

        <div class="mt-3">

            <button type="submit" class="btn btn-primary">
                Update Course
            </button>

            <a asp-action="Index"
               class="btn btn-secondary ms-2">
                Cancel
            </a>

        </div>

    </form>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
