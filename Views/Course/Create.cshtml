@model StudentManagementSystem.Models.Course

@{
    ViewData["Title"] = "Add Course";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold mb-1">
                <i class="bi bi-book-fill me-2"></i>
                Add Course
            </h1>

            <p class="text-muted mb-0">
                Create a new academic course.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-2"></i>
            Back to Courses

        </a>

    </div>


    <div class="card border-0 shadow-sm">

        <div class="card-body p-4">

            <form asp-action="Create" method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>


                <div class="mb-4">

                    <h5 class="fw-bold mb-3">
                        <i class="bi bi-book me-2"></i>
                        Course Information
                    </h5>

                    <div class="row g-4">

                        <div class="col-md-6">

                            <label asp-for="CourseName"
                                   class="form-label fw-semibold">
                                Course Name
                            </label>

                            <input asp-for="CourseName"
                                   class="form-control"
                                   placeholder="e.g. Bachelor of Computer Applications" />

                            <span asp-validation-for="CourseName"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="col-md-6">

                            <label asp-for="CourseCode"
                                   class="form-label fw-semibold">
                                Course Code
                            </label>

                            <input asp-for="CourseCode"
                                   class="form-control"
                                   placeholder="e.g. BCA101" />

                            <span asp-validation-for="CourseCode"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="col-md-6">

                            <label asp-for="Duration"
                                   class="form-label fw-semibold">
                                Duration
                            </label>

                            <input asp-for="Duration"
                                   class="form-control"
                                   placeholder="e.g. 3 Years" />

                            <span asp-validation-for="Duration"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="col-md-6">

                            <label asp-for="Status"
                                   class="form-label fw-semibold">
                                Status
                            </label>

                            <select asp-for="Status"
                                    class="form-select">

                                <option value="Active">
                                    Active
                                </option>

                                <option value="Inactive">
                                    Inactive
                                </option>

                            </select>

                            <span asp-validation-for="Status"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="col-12">

                            <label asp-for="Description"
                                   class="form-label fw-semibold">
                                Description
                            </label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Enter course description"></textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>

                </div>


                <hr class="my-4" />


                <div class="d-flex justify-content-end gap-2">

                    <a asp-action="Index"
                       class="btn btn-light border">

                        <i class="bi bi-x-circle me-2"></i>
                        Cancel

                    </a>

                    <button type="submit"
                            class="btn btn-primary px-4">

                        <i class="bi bi-check-circle me-2"></i>
                        Save Course

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}
