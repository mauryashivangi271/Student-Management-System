@model IEnumerable<StudentManagementSystem.Models.Course>

@{
    ViewData["Title"] = "Courses";
}

<div class="container-fluid">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold mb-1">
                <i class="bi bi-book-fill me-2"></i>
                Courses
            </h1>

            <p class="text-muted mb-0">
                Manage all courses available in the institution.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary px-4">

            <i class="bi bi-plus-circle me-2"></i>
            Add Course

        </a>

    </div>


    <!-- SUMMARY -->
    <div class="row g-4 mb-4">

        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body d-flex align-items-center gap-3">

                    <div class="rounded-3 bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center"
                         style="width:52px;height:52px;">

                        <i class="bi bi-book-fill fs-4"></i>

                    </div>

                    <div>

                        <small class="text-muted">
                            Total Courses
                        </small>

                        <h3 class="fw-bold mb-0">
                            @Model.Count()
                        </h3>

                    </div>

                </div>

            </div>

        </div>


        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body d-flex align-items-center gap-3">

                    <div class="rounded-3 bg-success bg-opacity-10 text-success d-flex align-items-center justify-content-center"
                         style="width:52px;height:52px;">

                        <i class="bi bi-check-circle-fill fs-4"></i>

                    </div>

                    <div>

                        <small class="text-muted">
                            Active Courses
                        </small>

                        <h3 class="fw-bold mb-0">
                            @Model.Count(c => c.Status == "Active")
                        </h3>

                    </div>

                </div>

            </div>

        </div>


        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body d-flex align-items-center gap-3">

                    <div class="rounded-3 bg-warning bg-opacity-10 text-warning d-flex align-items-center justify-content-center"
                         style="width:52px;height:52px;">

                        <i class="bi bi-people-fill fs-4"></i>

                    </div>

                    <div>

                        <small class="text-muted">
                            Enrolled Students
                        </small>

                        <h3 class="fw-bold mb-0">
                            @Model.Sum(c => c.Students?.Count ?? 0)
                        </h3>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- COURSE TABLE -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 p-4">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h5 class="fw-bold mb-1">
                        Course Records
                    </h5>

                    <small class="text-muted">
                        View and manage course information.
                    </small>

                </div>

                <span class="badge bg-primary rounded-pill px-3 py-2">
                    @Model.Count() Courses
                </span>

            </div>

        </div>


        @if (Model.Any())
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th class="px-4">
                                ID
                            </th>

                            <th>
                                Course
                            </th>

                            <th>
                                Code
                            </th>

                            <th>
                                Duration
                            </th>

                            <th>
                                Students
                            </th>

                            <th>
                                Status
                            </th>

                            <th class="text-center">
                                Actions
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var course in Model)
                        {
                            <tr>

                                <!-- ID -->
                                <td class="px-4">

                                    <span class="badge bg-light text-dark border">
                                        #@course.CourseId
                                    </span>

                                </td>


                                <!-- COURSE -->
                                <td>

                                    <div class="d-flex align-items-center gap-3">

                                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center"
                                             style="width:42px;height:42px;">

                                            <i class="bi bi-book"></i>

                                        </div>

                                        <div>

                                            <div class="fw-semibold">
                                                @course.CourseName
                                            </div>

                                            <small class="text-muted">
                                                @(string.IsNullOrWhiteSpace(course.Description)
                                                    ? "No description"
                                                    : course.Description)
                                            </small>

                                        </div>

                                    </div>

                                </td>


                                <!-- CODE -->
                                <td>

                                    <span class="badge bg-light text-dark border">
                                        @course.CourseCode
                                    </span>

                                </td>


                                <!-- DURATION -->
                                <td>
                                    @(string.IsNullOrWhiteSpace(course.Duration)
                                        ? "Not specified"
                                        : course.Duration)
                                </td>


                                <!-- STUDENTS -->
                                <td>

                                    <span class="fw-semibold">
                                        @(course.Students?.Count ?? 0)
                                    </span>

                                </td>


                                <!-- STATUS -->
                                <td>

                                    @if (course.Status == "Active")
                                    {
                                        <span class="badge bg-success-subtle text-success">
                                            <i class="bi bi-check-circle me-1"></i>
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary">
                                            <i class="bi bi-dash-circle me-1"></i>
                                            @course.Status
                                        </span>
                                    }

                                </td>


                                <!-- ACTIONS -->
                                <td>

                                    <div class="d-flex justify-content-center gap-1">

                                        <a asp-action="Details"
                                           asp-route-id="@course.CourseId"
                                           class="btn btn-sm btn-outline-primary"
                                           title="View Details">

                                            <i class="bi bi-eye"></i>

                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@course.CourseId"
                                           class="btn btn-sm btn-outline-secondary"
                                           title="Edit Course">

                                            <i class="bi bi-pencil"></i>

                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@course.CourseId"
                                           class="btn btn-sm btn-outline-danger"
                                           title="Delete Course">

                                            <i class="bi bi-trash"></i>

                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="text-center py-5">

                <i class="bi bi-book"
                   style="font-size:4rem;color:#adb5bd;"></i>

                <h4 class="fw-bold mt-3">
                    No Courses Found
                </h4>

                <p class="text-muted">
                    Start by adding your first course.
                </p>

                <a asp-action="Create"
                   class="btn btn-primary">

                    <i class="bi bi-plus-circle me-2"></i>
                    Add Course

                </a>

            </div>
        }

    </div>

</div>
