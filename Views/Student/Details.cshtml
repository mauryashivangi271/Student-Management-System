@model StudentManagementSystem.Models.Student

@{
    ViewData["Title"] = "Student Details";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold mb-1">
                <i class="bi bi-person-vcard-fill me-2"></i>
                Student Details
            </h1>

            <p class="text-muted mb-0">
                View complete information about this student.
            </p>
        </div>

        <div class="d-flex gap-2">

            <a asp-action="Edit"
               asp-route-id="@Model.StudentId"
               class="btn btn-primary">

                <i class="bi bi-pencil me-2"></i>
                Edit

            </a>

            <a asp-action="Index"
               class="btn btn-outline-secondary">

                <i class="bi bi-arrow-left me-2"></i>
                Back

            </a>

        </div>

    </div>


    <div class="row g-4">

        <!-- PROFILE -->
        <div class="col-lg-4">

            <div class="card border-0 shadow-sm text-center">

                <div class="card-body p-4">

                    <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center mx-auto mb-3"
                         style="width:90px;height:90px;font-size:32px;font-weight:700;">

                        @(string.IsNullOrWhiteSpace(Model.Name)
                            ? "?"
                            : Model.Name.Substring(0, 1).ToUpper())

                    </div>

                    <h3 class="fw-bold mb-1">
                        @Model.Name
                    </h3>

                    <p class="text-muted mb-3">
                        Student #@Model.StudentId
                    </p>

                    <span class="badge bg-success-subtle text-success px-3 py-2">
                        <i class="bi bi-check-circle me-1"></i>
                        Active Student
                    </span>

                </div>

            </div>


            <!-- CONTACT -->
            <div class="card border-0 shadow-sm mt-4">

                <div class="card-body p-4">

                    <h5 class="fw-bold mb-4">
                        <i class="bi bi-person-lines-fill me-2"></i>
                        Contact Information
                    </h5>

                    <div class="mb-3">

                        <small class="text-muted d-block">
                            Email
                        </small>

                        <span>
                            <i class="bi bi-envelope me-2"></i>
                            @Model.Email
                        </span>

                    </div>

                    <div class="mb-3">

                        <small class="text-muted d-block">
                            Phone
                        </small>

                        <span>
                            <i class="bi bi-telephone me-2"></i>
                            @Model.Phone
                        </span>

                    </div>

                    <div>

                        <small class="text-muted d-block">
                            Address
                        </small>

                        <span>
                            <i class="bi bi-geo-alt me-2"></i>
                            @(string.IsNullOrWhiteSpace(Model.Address)
                                ? "Not provided"
                                : Model.Address)
                        </span>

                    </div>

                </div>

            </div>

        </div>


        <!-- DETAILS -->
        <div class="col-lg-8">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4">

                    <h5 class="fw-bold mb-4">
                        <i class="bi bi-info-circle-fill me-2"></i>
                        Personal Information
                    </h5>

                    <div class="row g-4">

                        <div class="col-md-6">

                            <small class="text-muted d-block">
                                Full Name
                            </small>

                            <strong>
                                @Model.Name
                            </strong>

                        </div>

                        <div class="col-md-6">

                            <small class="text-muted d-block">
                                Gender
                            </small>

                            <strong>
                                @Model.Gender
                            </strong>

                        </div>

                        <div class="col-md-6">

                            <small class="text-muted d-block">
                                Date of Birth
                            </small>

                            <strong>
                                @Model.DateOfBirth.ToString("dd MMM yyyy")
                            </strong>

                        </div>

                        <div class="col-md-6">

                            <small class="text-muted d-block">
                                Enrollment Date
                            </small>

                            <strong>
                                @Model.EnrollmentDate.ToString("dd MMM yyyy")
                            </strong>

                        </div>

                    </div>

                </div>

            </div>


            <!-- ACADEMIC -->
            <div class="card border-0 shadow-sm mt-4">

                <div class="card-body p-4">

                    <h5 class="fw-bold mb-4">
                        <i class="bi bi-mortarboard-fill me-2"></i>
                        Academic Information
                    </h5>

                    <div class="row g-4">

                        <div class="col-md-6">

                            <small class="text-muted d-block">
                                Course
                            </small>

                            <strong>
                                @(Model.Course?.CourseName ?? "Not assigned")
                            </strong>

                            @if (Model.Course != null)
                            {
                                <small class="text-muted d-block mt-1">
                                    Code: @Model.Course.CourseCode
                                </small>
                            }

                        </div>

                        <div class="col-md-6">

                            <small class="text-muted d-block">
                                Department
                            </small>

                            <strong>
                                @(Model.Department?.DepartmentName ?? "Not assigned")
                            </strong>

                            @if (Model.Department != null)
                            {
                                <small class="text-muted d-block mt-1">
                                    Code: @Model.Department.DepartmentCode
                                </small>
                            }

                        </div>

                    </div>

                </div>

            </div>


            <!-- DANGER AREA -->
            <div class="card border-0 shadow-sm mt-4">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <h6 class="fw-bold mb-1">
                                Student Management
                            </h6>

                            <small class="text-muted">
                                Remove this student from the system.
                            </small>

                        </div>

                        <a asp-action="Delete"
                           asp-route-id="@Model.StudentId"
                           class="btn btn-outline-danger">

                            <i class="bi bi-trash me-2"></i>
                            Delete Student

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>
