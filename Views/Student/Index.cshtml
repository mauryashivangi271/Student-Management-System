@model IEnumerable<StudentManagementSystem.Models.Student>

@{
    ViewData["Title"] = "Students";

    var students = Model.ToList();
}

<div class="container-fluid py-4">

    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-people-fill me-2"></i>
                Students
            </h2>

            <p class="text-muted mb-0">
                Manage, search and filter student records
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-person-plus-fill me-2"></i>
            Add Student
        </a>

    </div>


    <!-- Filters -->
    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body">

            <form asp-action="Index"
                  method="get">

                <div class="row g-3">

                    <!-- Search -->
                    <div class="col-lg-3 col-md-6">

                        <label class="form-label fw-semibold">
                            Search
                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                <i class="bi bi-search"></i>
                            </span>

                            <input type="text"
                                   name="search"
                                   value="@ViewBag.Search"
                                   class="form-control"
                                   placeholder="Name, email or phone" />

                        </div>

                    </div>


                    <!-- Course -->
                    <div class="col-lg-2 col-md-6">

                        <label class="form-label fw-semibold">
                            Course
                        </label>

                        <select name="courseId"
                                class="form-select"
                                asp-items="ViewBag.FilterCourses">

                            <option value="">
                                All Courses
                            </option>

                        </select>

                    </div>


                    <!-- Department -->
                    <div class="col-lg-2 col-md-6">

                        <label class="form-label fw-semibold">
                            Department
                        </label>

                        <select name="departmentId"
                                class="form-select"
                                asp-items="ViewBag.FilterDepartments">

                            <option value="">
                                All Departments
                            </option>

                        </select>

                    </div>


                    <!-- From Date -->
                    <div class="col-lg-2 col-md-6">

                        <label class="form-label fw-semibold">
                            From Date
                        </label>

                        <input type="date"
                               name="fromDate"
                               value="@ViewBag.FromDate"
                               class="form-control" />

                    </div>


                    <!-- To Date -->
                    <div class="col-lg-2 col-md-6">

                        <label class="form-label fw-semibold">
                            To Date
                        </label>

                        <input type="date"
                               name="toDate"
                               value="@ViewBag.ToDate"
                               class="form-control" />

                    </div>


                    <!-- Buttons -->
                    <div class="col-lg-1 col-md-6 d-flex align-items-end">

                        <button type="submit"
                                class="btn btn-primary w-100"
                                title="Apply Filters">

                            <i class="bi bi-funnel-fill"></i>

                        </button>

                    </div>

                </div>


                <!-- Reset -->
                <div class="mt-3">

                    <a asp-action="Index"
                       class="btn btn-sm btn-outline-secondary">

                        <i class="bi bi-arrow-clockwise me-1"></i>
                        Reset Filters

                    </a>

                </div>

            </form>

        </div>

    </div>


    <!-- Student Count -->
    <div class="d-flex justify-content-between align-items-center mb-3">

        <div>
            <span class="fw-semibold">
                Student Records
            </span>

            <span class="badge bg-primary ms-2">
                @students.Count
            </span>
        </div>

    </div>


    <!-- Student Table -->
    <div class="card border-0 shadow-sm">

        <div class="card-body p-0">

            @if (students.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th class="ps-4">
                                    Student
                                </th>

                                <th>
                                    Contact
                                </th>

                                <th>
                                    Gender
                                </th>

                                <th>
                                    Course
                                </th>

                                <th>
                                    Department
                                </th>

                                <th>
                                    Enrollment
                                </th>

                                <th class="text-end pe-4">
                                    Actions
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var student in students)
                            {
                                <tr>

                                    <!-- Student -->
                                    <td class="ps-4">

                                        <div class="d-flex align-items-center">

                                            <div class="rounded-circle bg-primary text-white
                                                        d-flex align-items-center justify-content-center
                                                        me-3"
                                                 style="width:42px;height:42px;">

                                                @student.Name.Substring(0, 1).ToUpper()

                                            </div>

                                            <div>

                                                <div class="fw-semibold">
                                                    @student.Name
                                                </div>

                                                <small class="text-muted">
                                                    ID: #@student.StudentId
                                                </small>

                                            </div>

                                        </div>

                                    </td>


                                    <!-- Contact -->
                                    <td>

                                        <div>
                                            <i class="bi bi-envelope me-1"></i>
                                            @student.Email
                                        </div>

                                        <small class="text-muted">
                                            <i class="bi bi-telephone me-1"></i>
                                            @student.Phone
                                        </small>

                                    </td>


                                    <!-- Gender -->
                                    <td>
                                        @student.Gender
                                    </td>


                                    <!-- Course -->
                                    <td>

                                        @if (student.Course != null)
                                        {
                                            <span class="badge bg-primary-subtle text-primary">
                                                @student.Course.CourseName
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Not assigned
                                            </span>
                                        }

                                    </td>


                                    <!-- Department -->
                                    <td>

                                        @if (student.Department != null)
                                        {
                                            <span class="badge bg-info-subtle text-info-emphasis">
                                                @student.Department.DepartmentName
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Not assigned
                                            </span>
                                        }

                                    </td>


                                    <!-- Enrollment -->
                                    <td>
                                        @student.EnrollmentDate.ToString("dd MMM yyyy")
                                    </td>


                                    <!-- Actions -->
                                    <td class="text-end pe-4">

                                        <div class="btn-group">

                                            <a asp-action="Details"
                                               asp-route-id="@student.StudentId"
                                               class="btn btn-sm btn-outline-info"
                                               title="Details">

                                                <i class="bi bi-eye"></i>

                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@student.StudentId"
                                               class="btn btn-sm btn-outline-primary"
                                               title="Edit">

                                                <i class="bi bi-pencil"></i>

                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@student.StudentId"
                                               class="btn btn-sm btn-outline-danger"
                                               title="Delete">

                                                <i class="bi bi-trash"></i>

                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <!-- Empty State -->

                <div class="text-center py-5">

                    <div class="mb-3">

                        <i class="bi bi-people display-4 text-muted"></i>

                    </div>

                    <h5>
                        No students found
                    </h5>

                    <p class="text-muted">
                        Try changing your search or filters.
                    </p>

                    <a asp-action="Create"
                       class="btn btn-primary">

                        <i class="bi bi-person-plus me-2"></i>
                        Add Student

                    </a>

                </div>
            }

        </div>

    </div>

</div>